# SentraX Environment Configuration
# Copy this file to .env and adjust as needed

SENTRAX_HOST=0.0.0.0
SENTRAX_PORT=8000
SENTRAX_DEBUG=True

# Hardware Serial Ports (when connected to USB)
SERIAL_PORT_ESP32=COM3
SERIAL_PORT_ESP8266=COM4
SERIAL_BAUDRATE=9600

# Google Maps Platform API Key (Optional - Mock route provider is used if omitted)
# Generate from Google Cloud Console with Routes API and Maps JavaScript API enabled
GOOGLE_MAPS_API_KEY=

# Ask SentraX copilot (Claude). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional overrides
SENTRAX_AI_MODEL=claude-opus-5-5
SENTRAX_AI_EFFORT=medium
